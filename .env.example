# Настройки деплоя (docker compose + ops/deploy.sh). На сервере: cp .env.example .env
# В git .env не попадает. Значения без пробелов — файл читается и compose, и bash.

# Хост-порт игры. 61873 выбран вне 3xxx/8xxx соседей и выше эфемерного диапазона
# Linux (32768–60999) — см. DEPLOY.md «Порты». Менять только если и он занят.
POCKET_OF_EMPIRE_PORT=61873

# Куда публиковать порт: 127.0.0.1 — за хостовым nginx (обычный случай),
# 0.0.0.0 — без nginx, игра открывается напрямую по http://<ip>:61873
POCKET_OF_EMPIRE_BIND=127.0.0.1

# .env, оставшийся с тех пор, как игра называлась Rookfall, переписывать не обязательно:
# ROOKFALL_PORT / ROOKFALL_BIND по-прежнему читаются (docker-compose.yml, ops/deploy.sh),
# новые имена, если заданы, главнее

# Публичный адрес игры. Если задан, ops/deploy.sh после переключения проверяет,
# что домен отдаёт развёрнутый коммит, а не что-то другое (старый порт, статику с диска).
# PUBLIC_URL=https://pocket-of-empire.example.com

# Ветка для ./ops/deploy.sh без аргументов (по умолчанию — выкачанная на сервере)
# DEPLOY_BRANCH=master

# Сколько секунд ждать /api/health новой версии, прежде чем откатиться
# READY_TIMEOUT=90
