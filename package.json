{
  "name": "rookfall",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"pnpm --filter @rookfall/server dev\" \"pnpm --filter @rookfall/client dev\"",
    "build": "pnpm --filter @rookfall/client build && pnpm --filter @rookfall/server build",
    "start": "node packages/server/dist/index.js",
    "test": "vitest run",
    "test:determinism": "vitest run --project sim --project ai",
    "typecheck": "tsc --noEmit -p packages/sim && tsc --noEmit -p packages/ai && tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/server && tsc --noEmit -p packages/client",
    "gen-maps": "tsx packages/sim/scripts/gen-maps.ts",
    "assets": "node scripts/copy-models.mjs",
    "bench": "tsx packages/sim/bench/bench.ts",
    "e2e": "node scripts/e2e/run.mjs",
    "perf": "node scripts/perf/run.mjs",
    "perf:report": "node scripts/perf/report.mjs",
    "e2e:clean": "node scripts/e2e/clean.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.0",
    "@gltf-transform/extensions": "4.5.0",
    "@gltf-transform/functions": "4.5.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.0",
    "meshoptimizer": "1.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.18.3"
  }
}
