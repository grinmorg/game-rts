{
  "name": "@rookfall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:ws --external:bufferutil --external:utf-8-validate",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@rookfall/ai": "workspace:*",
    "@rookfall/protocol": "workspace:*",
    "@rookfall/sim": "workspace:*",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
